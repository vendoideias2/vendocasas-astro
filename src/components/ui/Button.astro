---
// ==========================================================================
// BUTTON COMPONENT
// ==========================================================================

interface Props {
  variant?: 'primary' | 'ghost' | 'outline' | 'subtle' | 'danger';
  size?: 'sm' | 'md' | 'lg' | 'icon';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  loading?: boolean;
  leftIcon?: string;
  rightIcon?: string;
  'aria-label'?: string;
  'aria-expanded'?: boolean;
  'aria-controls'?: string;
  'aria-pressed'?: boolean;
  class?: string;
  children: Props['children'];
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  loading = false,
  leftIcon,
  rightIcon,
  class: className = '',
  children,
  ...attrs
} = Astro.props;

const isLink = !!href;
const Tag = isLink ? 'a' : 'button';

const baseClasses = `
  inline-flex items-center justify-center gap-2
  font-medium rounded-md
  transition-all duration-150 ease-out
  disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus)]
  focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-white)]
`;

const variantClasses = {
  primary: 'bg-[var(--color-accent)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-hover)] active:scale-[0.98]',
  ghost: 'text-[var(--color-text-primary)] hover:bg-[var(--color-surface-elevated)] active:scale-[0.98]',
  outline: 'border border-[var(--color-border)] text-[var(--color-text-primary)] hover:bg-[var(--color-surface-elevated)] hover:border-[var(--color-border-strong)] active:scale-[0.98]',
  subtle: 'bg-[var(--color-accent-soft)] text-[var(--color-accent)] hover:bg-[var(--color-accent-lighter)] active:scale-[0.98]',
  danger: 'bg-[var(--color-rose)] text-[var(--color-text-inverse)] hover:bg-[var(--color-rose)]/90 active:scale-[0.98]',
};

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3 text-base',
  icon: 'p-2.5',
};

const widthClass = fullWidth ? 'w-full' : '';
const loadingClass = loading ? 'relative' : '';

const finalClass = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${widthClass} ${loadingClass} ${className}`.replace(/\s+/g, ' ').trim();

const spinner = `
  <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none"/>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
  </svg>
`;
---

<{Tag}
  {...attrs}
  href={href}
  type={isLink ? undefined : type}
  disabled={disabled || loading}
  aria-disabled={disabled || loading}
  aria-busy={loading}
  aria-label={attrs['aria-label']}
  aria-expanded={attrs['aria-expanded']}
  aria-controls={attrs['aria-controls']}
  aria-pressed={attrs['aria-pressed']}
  class={finalClass}
>
  {loading ? spinner : leftIcon}
  <slot>{children}</slot>
  {!loading && rightIcon}
</{Tag}>

<style>
  .animate-spin {
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>