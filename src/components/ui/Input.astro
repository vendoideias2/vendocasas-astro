---
// ==========================================================================
// INPUT COMPONENT
// ==========================================================================

import { uniqueId } from 'crypto';

interface Props {
  type?: 'text' | 'email' | 'tel' | 'number' | 'search' | 'url' | 'password';
  label?: string;
  placeholder?: string;
  value?: string;
  name: string;
  id?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  error?: string;
  hint?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'numeric' | 'decimal' | 'tel' | 'email' | 'search';
  pattern?: string;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  class?: string;
  'aria-describedby'?: string;
}

const {
  type = 'text',
  label,
  placeholder,
  value,
  name,
  id = uniqueId('input-'),
  required = false,
  disabled = false,
  readonly = false,
  error,
  hint,
  autocomplete,
  inputmode,
  pattern,
  min,
  max,
  step,
  class: className = '',
  'aria-describedby': ariaDescribedBy,
  ...attrs
} = Astro.props;

const describedBy = [error && `${id}-error`, hint && `${id}-hint`, ariaDescribedBy].filter(Boolean).join(' ') || undefined;
---

<div class="form-field {className}">
  {label && (
    <label for={id} class="form-field__label">
      {label}
      {required && <span class="form-field__required" aria-hidden="true">*</span>}
    </label>
  )}

  <input
    type={type}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    readonly={readonly}
    autocomplete={autocomplete}
    inputmode={inputmode}
    pattern={pattern}
    min={min}
    max={max}
    step={step}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={describedBy}
    aria-required={required}
    class="form-field__input {error ? 'form-field__input--error' : ''}"
    {...attrs}
  />

  {error && (
    <p id={`${id}-error`} class="form-field__error" role="alert" aria-live="polite">
      {error}
    </p>
  )}

  {hint && !error && (
    <p id={`${id}-hint`} class="form-field__hint">
      {hint}
    </p>
  )}
</div>

<style>
  .form-field {
    @apply w-full;
  }

  .form-field__label {
    @apply block text-sm font-medium text-[var(--color-text-primary)] mb-1.5;
  }

  .form-field__required {
    @apply text-[var(--color-rose)] ml-0.5;
  }

  .form-field__input {
    @apply w-full px-4 py-2.5
           bg-[var(--color-surface)] border border-[var(--color-border)]
           rounded-md text-[var(--color-text-primary)]
           placeholder:text-[var(--color-text-muted)]
           transition-all duration-150 var(--ease-out);
  }

  .form-field__input:hover:not(:disabled):not(:read-only) {
    @apply border-[var(--color-border-strong)];
  }

  .form-field__input:focus {
    @apply outline-none border-[var(--color-accent)]
           ring-3 ring-[var(--color-accent-lighter)];
  }

  .form-field__input:disabled,
  .form-field__input:read-only {
    @apply bg-[var(--color-surface-hover)] text-[var(--color-text-muted)] cursor-not-allowed;
  }

  .form-field__input--error {
    @apply border-[var(--color-rose)] focus:border-[var(--color-rose)] focus:ring-[var(--color-rose-light)];
  }

  .form-field__error {
    @apply mt-1.5 text-sm text-[var(--color-rose)];
  }

  .form-field__hint {
    @apply mt-1.5 text-sm text-[var(--color-text-muted)];
  }
</style>