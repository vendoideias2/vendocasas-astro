---
// ==========================================================================
// SEARCH PAGE — Busca avançada com mapa (split view) - VendoCasas Brand
// ==========================================================================

import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/property/PropertyCard.astro';
import ChipGroup from '../components/ui/ChipGroup.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Button from '../components/ui/Button.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SearchResultsPage',
  'name': 'Busca Avançada de Imóveis — VendoCasas',
  'description': 'Busca avançada de imóveis com filtros por preço, tipo, quartos, bairro, MCMV e mapa interativo. Encontre seu imóvel ideal em Cedral, São José do Rio Preto e região.',
  'url': 'https://vendocasas.com.br/busca',
};

const propertyTypes = [
  { value: 'house', label: 'Casa', count: 480 },
  { value: 'apartment', label: 'Apartamento', count: 320 },
  { value: 'land', label: 'Terreno', count: 180 },
];

const transactionTypes = [
  { value: 'sale', label: 'Comprar' },
  { value: 'rent', label: 'Alugar' },
];

const cities = [
  { value: 'sao-jose-do-rio-preto', label: 'São José do Rio Preto', count: 520 },
  { value: 'cedral', label: 'Cedral', count: 280 },
  { value: 'mirassol', label: 'Mirassol', count: 150 },
  { value: 'bady-bassitt', label: 'Bady Bassitt', count: 90 },
];

const sortOptions = [
  { value: 'relevance', label: 'Relevância' },
  { value: 'price-asc', label: 'Menor preço' },
  { value: 'price-desc', label: 'Maior preço' },
  { value: 'area-desc', label: 'Maior área' },
  { value: 'newest', label: 'Mais recentes' },
];

// Mock results
const results = Array.from({ length: 20 }, (_, i) => {
  const tipos = ['Casa térrea', 'Apartamento', 'Casa moderna', 'Casa de vila', 'Apartamento studio'];
  const bairros = ['Jardim Oliveiras', 'Cambuí Reserva da Mata', 'Vale do Sol', 'Jardim Norte', 'Centro'];
  const cidades = ['São José do Rio Preto', 'Cedral', 'Mirassol', 'Bady Bassitt'];
  const tiposProp = ['house', 'apartment', 'house', 'house', 'apartment'] as const;

  return {
    id: `search-result-${i + 1}`,
    title: `${tipos[i % 5]} ${i + 1}`,
    address: `Rua ${['das Flores', 'dos Pinheiros', 'Harmonia', 'Madrugada', 'Aurora'][i % 5]}, ${100 + i * 10}`,
    neighborhood: bairros[i % 5],
    city: cidades[i % 4],
    state: 'SP',
    price: [125000, 195000, 245000, 285000, 320000, 420000, 520000, 680000][i % 8],
    priceType: (i % 2 === 0 ? 'sale' : 'rent') as const,
    condoFee: [0, 420, 250, 380, 450, 680, 850, 1200][i % 8],
    iptu: [450, 680, 850, 1200, 1800, 2100, 3200, 4200][i % 8],
    bedrooms: [0, 2, 2, 3, 1, 2, 3, 4][i % 8],
    bathrooms: [0, 1, 1, 2, 1, 1, 2, 2][i % 8],
    parkingSpaces: [0, 1, 2, 2, 0, 1, 2, 3][i % 8],
    area: [300, 44, 65, 110, 42, 85, 135, 180][i % 8],
    propertyType: tiposProp[i % 5],
    status: 'available' as const,
    featured: i < 2,
    images: [`/images/prop-${i + 1}-1.jpg`],
    mainImage: `/images/prop-${i + 1}-1.jpg`,
    tags: i % 3 === 0 ? ['MCMV Faixa 1', 'Novo', 'Exclusivo'] : i % 3 === 1 ? ['Queda de preço', 'Condomínio fechado'] : ['Pronto para morar', 'Lazer completo'],
    lat: -20.8 + (Math.random() - 0.5) * 0.1,
    lng: -49.4 + (Math.random() - 0.5) * 0.1,
    mcmvFaixa: [1, 1, 1, 2, 2, 3, 4, null][i % 8] as 1 | 2 | 3 | 4 | null,
  };
});
---

<BaseLayout
  title="Busca Avançada de Imóveis — VendoCasas"
  description="Busca avançada com filtros por preço, tipo, quartos, bairro, MCMV e mapa interativo. Encontre seu imóvel ideal em Cedral, São José do Rio Preto e região."
  canonical="/busca"
  structuredData={structuredData}
>
  <div class="search-page">
    <!-- Hero Search Bar -->
    <header class="bg-[var(--color-cream)] border-b border-[var(--color-border)] py-8 lg:py-12" aria-label="Busca principal">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <span class="eyebrow text-center block mb-2" style="color: var(--color-accent-gold);">Busca Inteligente</span>
          <h1 class="font-display font-semibold text-center mb-4" style="font-size: var(--text-h2);">Encontre exatamente o que procura</h1>
          <p class="text-center text-[var(--color-text-secondary)] mb-8">Combine filtros, desenhe no mapa e descubra imóveis que combinam com seu perfil e orçamento.</p>

          <form class="search-form bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 shadow-lg" action="/busca" method="GET">
            <div class="grid sm:grid-cols-4 gap-3 mb-4">
              <Select
                name="transaction"
                id="search-transaction"
                label="Negócio"
                options={transactionTypes}
                value="sale"
                class="min-w-0"
              />
              <Input
                type="search"
                name="q"
                id="search-q"
                placeholder="Bairro, cidade, rua, referência..."
                class="min-w-0"
                aria-label="Onde você quer morar?"
              />
              <Select
                name="property_type"
                id="search-property-type"
                label="Tipo"
                options={propertyTypes}
                class="min-w-0"
              />
              <Select
                name="city"
                id="search-city"
                label="Cidade"
                options={cities}
                class="min-w-0"
              />
            </div>

            <div class="flex flex-wrap items-end gap-3">
              <div class="flex-1 min-w-[200px]">
                <label for="price-range" class="form-field__label">Faixa de preço</label>
                <div class="flex items-center gap-2">
                  <Input type="number" name="price_min" placeholder="Mín." inputmode="numeric" class="w-24" aria-label="Preço mínimo" />
                  <span class="text-[var(--color-text-muted)]">a</span>
                  <Input type="number" name="price_max" placeholder="Máx." inputmode="numeric" class="w-24" aria-label="Preço máximo" />
                </div>
              </div>
              <div class="flex-1 min-w-[150px]">
                <label class="form-field__label">Quartos</label>
                <Select
                  name="bedrooms"
                  id="search-bedrooms"
                  options={[
                    { value: '', label: 'Qualquer' },
                    { value: '1', label: '1+' },
                    { value: '2', label: '2+' },
                    { value: '3', label: '3+' },
                    { value: '4', label: '4+' },
                    { value: '5', label: '5+' },
                  ]}
                />
              </div>
              <Button type="submit" class="h-11 lg:h-12 w-full sm:w-auto" size="lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                Buscar
              </Button>
              <Button type="button" variant="outline" class="h-11 lg:h-12 w-full sm:w-auto" id="advanced-filters-trigger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                Filtros avançados
              </Button>
            </div>
          </form>
        </div>
      </div>
    </header>

    <!-- Main: Sidebar + Map/Results Split -->
    <div class="container py-8">
      <div class="grid lg:grid-cols-4 gap-6">
        <!-- Sidebar Filters (Drawer on Mobile) -->
        <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-12rem)] lg:overflow-y-auto hidden lg:block" aria-label="Filtros avançados">
          <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-5">
            <button class="lg:hidden w-full justify-between mb-4 btn-ghost" id="search-filters-close" aria-label="Fechar filtros">
              <span>Filtros ativos</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg>
            </button>

            <ChipGroup
              name="property_type"
              label="Tipo de imóvel"
              chips={propertyTypes}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="transaction_type"
              label="Tipo de negócio"
              chips={[
                { value: 'sale', label: 'Comprar', count: 890 },
                { value: 'rent', label: 'Alugar', count: 210 },
              ]}
              multiple={false}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="city"
              label="Cidade"
              chips={cities}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="bedrooms"
              label="Quartos"
              chips={[
                { value: '1', label: '1+', count: 280 },
                { value: '2', label: '2+', count: 520 },
                { value: '3', label: '3+', count: 380 },
                { value: '4', label: '4+', count: 150 },
              ]}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="bathrooms"
              label="Banheiros"
              chips={[
                { value: '1', label: '1+', count: 480 },
                { value: '2', label: '2+', count: 420 },
                { value: '3', label: '3+', count: 180 },
              ]}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="parking"
              label="Vagas"
              chips={[
                { value: '1', label: '1+', count: 620 },
                { value: '2', label: '2+', count: 380 },
                { value: '3', label: '3+', count: 120 },
              ]}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <fieldset class="mb-6">
              <legend class="text-sm font-medium text-[var(--color-text-primary)] mb-3">Área (m²)</legend>
              <div class="flex items-center gap-3">
                <Input type="number" name="area_min" placeholder="Mín." inputmode="numeric" class="w-24" aria-label="Área mínima" />
                <span class="text-[var(--color-text-muted)]">a</span>
                <Input type="number" name="area_max" placeholder="Máx." inputmode="numeric" class="w-24" aria-label="Área máxima" />
              </div>
            </fieldset>

            <ChipGroup
              name="mcmv"
              label="Programa MCMV"
              chips={[
                { value: '1', label: 'Faixa 1 (até R$ 3.200)', count: 280 },
                { value: '2', label: 'Faixa 2 (R$ 3.201-5.000)', count: 220 },
                { value: '3', label: 'Faixa 3 (R$ 5.001-9.600)', count: 180 },
                { value: '4', label: 'Faixa 4 (R$ 9.601-13.000)', count: 95 },
                { value: 'none', label: 'Não se enquadra', count: 120 },
              ]}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <ChipGroup
              name="features"
              label="Características"
              chips={[
                { value: 'pool', label: 'Piscina', count: 180 },
                { value: 'garden', label: 'Jardim/Quintal', count: 320 },
                { value: 'gourmet', label: 'Área gourmet', count: 150 },
                { value: 'security', label: 'Segurança 24h', count: 380 },
                { value: 'pet', label: 'Pet friendly', count: 280 },
              ]}
              multiple={true}
              variant="outline"
              class="mb-6"
            />

            <div class="flex flex-col gap-2 pt-4 border-t border-[var(--color-border)]">
              <Button variant="primary" class="w-full" id="search-apply-filters">Aplicar filtros</Button>
              <Button variant="ghost" class="w-full" id="search-clear-filters">Limpar todos</Button>
            </div>
          </div>
        </aside>

        <!-- Map + Results Area -->
        <main class="lg:col-span-3" role="main" aria-label="Resultados da busca">
          <!-- Mobile Filters Trigger -->
          <button
            class="lg:hidden btn-outline w-full justify-center gap-2 mb-6"
            id="search-filters-trigger"
            aria-expanded="false"
            aria-controls="search-filters-drawer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            <span>Filtros</span>
            <span class="filter-count text-[var(--color-accent-gold)] font-medium" aria-live="polite">0</span>
          </button>

          <!-- View Mode Toggle -->
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="text-[var(--color-text-secondary)]">
                <strong>{results.length}</strong> imóveis encontrados
              </span>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <div class="flex items-center gap-1 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md p-1" role="group" aria-label="Visualização">
                <button type="button" class="view-btn p-2 rounded-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-surface-elevated)] transition-colors" aria-label="Grade" aria-pressed="true" data-view="grid">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                </button>
                <button type="button" class="view-btn p-2 rounded-sm text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-surface-elevated)] transition-colors" aria-label="Lista" aria-pressed="false" data-view="list">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <button type="button" class="view-btn p-2 rounded-sm text-[var(--color-text-secondary)] bg-[var(--color-purple-light)]" aria-label="Mapa" aria-pressed="true" data-view="map">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/><path d="M12 2v20M2 8.5h20M2 15.5h20"/><circle cx="12" cy="13" r="3"/></svg>
                </button>
              </div>

              <Select
                name="sort"
                id="results-sort"
                label="Ordenar"
                options={sortOptions}
                value="relevance"
                class="w-48"
              />
            </div>
          </div>

          <!-- Split View: Map (Left) + Results (Right) on Desktop -->
          <div class="split-view lg:grid lg:grid-cols-2 lg:gap-6 lg:h-[calc(100vh-14rem)]">
            <!-- Map Panel -->
            <div class="map-panel lg:sticky lg:top-24 lg:h-[calc(100vh-14rem)] relative" role="region" aria-label="Mapa de imóveis" data-view="map">
              <div id="search-map-container" class="w-full h-full rounded-xl border border-[var(--color-border)] relative overflow-hidden bg-[var(--color-cream-dark)]">
                <div class="absolute inset-0 flex items-center justify-center text-[var(--color-text-muted)] z-10">
                  <div class="text-center p-8">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-50" aria-hidden="true">
                      <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/>
                      <path d="M12 2v20M2 8.5h20M2 15.5h20"/>
                      <circle cx="12" cy="13" r="3"/>
                    </svg>
                    <p class="text-lg font-medium">Mapa interativo</p>
                    <p class="text-sm mt-1">Integração com MapLibre GL JS — carregamento sob demanda</p>
                    <div class="flex flex-col sm:flex-row gap-2 mt-4 justify-center">
                      <Button variant="outline" id="load-search-map-btn" class="w-full sm:w-auto">Carregar mapa</Button>
                      <Button variant="ghost" id="toggle-map-layers" class="w-full sm:w-auto">Camadas</Button>
                    </div>
                  </div>
                </div>

                <!-- Map Controls (visible when map loaded) -->
                <div class="map-controls absolute top-4 right-4 z-20 flex flex-col gap-2 hidden" id="map-controls">
                  <Button variant="outline" size="sm" class="w-10 h-10 p-0" aria-label="Zoom in"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></Button>
                  <Button variant="outline" size="sm" class="w-10 h-10 p-0" aria-label="Zoom out"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg></Button>
                  <Button variant="outline" size="sm" class="w-10 h-10 p-0" aria-label="Minha localização"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 22v2M2 12h2M22 12h2"/></svg></Button>
                  <Button variant="outline" size="sm" class="w-10 h-10 p-0" aria-label="Desenhar área"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/><path d="M12 2v20"/></svg></Button>
                </div>
              </div>
            </div>

            <!-- Results Panel -->
            <div class="results-panel lg:overflow-y-auto lg:max-h-[calc(100vh-14rem)]" data-view="grid">
              <!-- Grid View -->
              <div class="properties-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4" role="list" aria-label="Lista de imóveis">
                {results.map((property, index) => (
                  <PropertyCard property={property} variant={property.featured ? 'featured' : 'default'} priority={index < 2} />
                ))}
              </div>

              <!-- List View -->
              <div class="properties-list hidden space-y-3" role="list" aria-label="Lista de imóveis">
                {results.map((property, index) => (
                  <PropertyCard property={property} variant="horizontal" priority={index < 2} />
                ))}
              </div>

              <!-- Pagination -->
              <nav class="mt-6 flex items-center justify-center gap-2" aria-label="Paginação" role="navigation">
                <Button variant="outline" size="sm" aria-label="Página anterior" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg></Button>
                <Button variant="primary" size="sm" aria-label="Página 1" aria-current="page">1</Button>
                <Button variant="outline" size="sm" aria-label="Página 2">2</Button>
                <Button variant="outline" size="sm" aria-label="Página 3">3</Button>
                <span class="px-3 text-[var(--color-text-muted)]" aria-hidden="true">…</span>
                <Button variant="outline" size="sm" aria-label="Página 5">5</Button>
                <Button variant="outline" size="sm" aria-label="Próxima página"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg></Button>
              </nav>
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Mobile Filters Drawer -->
    <div id="search-filters-drawer" class="lg:hidden fixed inset-0 z-[var(--z-modal)] transform translate-x-full transition-transform duration-300 ease-out" role="dialog" aria-modal="true" aria-label="Filtros avançados" hidden>
      <div class="absolute inset-0 bg-[var(--color-charcoal)]/50 backdrop-blur-sm" aria-hidden="true"></div>
      <aside class="absolute top-0 right-0 bottom-0 w-full max-w-sm bg-[var(--color-surface)] shadow-xl flex flex-col overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-[var(--color-border)] sticky top-0 bg-[var(--color-surface)] z-10">
          <h2 class="font-display text-lg">Filtros avançados</h2>
          <button class="p-2 rounded-md text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-elevated)]" id="search-drawer-close" aria-label="Fechar filtros"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/></svg></button>
        </div>
        <div class="flex-1 overflow-y-auto p-4 space-y-6">
          <ChipGroup name="property_type" label="Tipo de imóvel" chips={propertyTypes} multiple={true} variant="outline" />
          <ChipGroup name="transaction_type" label="Tipo de negócio" chips={[{ value: 'sale', label: 'Comprar', count: 890 }, { value: 'rent', label: 'Alugar', count: 210 }]} multiple={false} variant="outline" />
          <ChipGroup name="city" label="Cidade" chips={cities} multiple={true} variant="outline" />
          <ChipGroup name="bedrooms" label="Quartos" chips={[{ value: '1', label: '1+', count: 280 }, { value: '2', label: '2+', count: 520 }, { value: '3', label: '3+', count: 380 }, { value: '4', label: '4+', count: 150 }]} multiple={true} variant="outline" />
          <ChipGroup name="mcmv" label="Programa MCMV" chips={[{ value: '1', label: 'Faixa 1 (até R$ 3.200)', count: 280 }, { value: '2', label: 'Faixa 2 (R$ 3.201-5.000)', count: 220 }, { value: '3', label: 'Faixa 3 (R$ 5.001-9.600)', count: 180 }, { value: '4', label: 'Faixa 4 (R$ 9.601-13.000)', count: 95 }, { value: 'none', label: 'Não se enquadra', count: 120 }]} multiple={true} variant="outline" />
          <ChipGroup name="features" label="Características" chips={[{ value: 'pool', label: 'Piscina', count: 180 }, { value: 'garden', label: 'Jardim/Quintal', count: 320 }, { value: 'gourmet', label: 'Área gourmet', count: 150 }, { value: 'security', label: 'Segurança 24h', count: 380 }, { value: 'gated', label: 'Condomínio fechado', count: 310 }]} multiple={true} variant="outline" />
