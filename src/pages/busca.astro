<script is:inline>
  (function() {
    // View toggle
    const viewButtons = document.querySelectorAll('.view-btn');
    const gridView = document.querySelector('.properties-grid');
    const listView = document.querySelector('.properties-list');

    viewButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view;
        viewButtons.forEach(b => {
          b.setAttribute('aria-pressed', b === btn);
          const isActive = b === btn;
          b.classList.toggle('bg-[var(--color-purple-light)]', isActive);
          b.classList.toggle('text-[var(--color-text-secondary)]', isActive);
          b.classList.toggle('text-[var(--color-text-muted)]', !isActive);
        });

        if (view === 'grid') {
          gridView?.classList.remove('hidden');
          listView?.classList.add('hidden');
        } else if (view === 'list') {
          gridView?.classList.add('hidden');
          listView?.classList.remove('hidden');
        }
      });
    });

    // Mobile filters drawer
    const trigger = document.getElementById('search-filters-trigger');
    const drawer = document.getElementById('search-filters-drawer');
    const closeBtn = document.getElementById('search-drawer-close');
    const applyBtn = document.getElementById('search-drawer-apply');
    const clearBtn = document.getElementById('search-drawer-clear');
    const sidebarClose = document.getElementById('search-filters-close');

    let lastFocused = null;

    function openDrawer() {
      lastFocused = document.activeElement;
      drawer.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
      });
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      drawer.classList.add('translate-x-full');
      drawer.classList.remove('translate-x-0');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => {
        drawer.hidden = true;
        lastFocused?.focus();
      }, 300);
    }

    trigger?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    applyBtn?.addEventListener('click', closeDrawer);
    clearBtn?.addEventListener('click', () => {
      drawer.querySelectorAll('.chip--selected').forEach(c => {
        c.classList.remove('chip--selected');
        c.setAttribute('aria-checked', 'false');
      });
    });
    sidebarClose?.addEventListener('click', closeDrawer);

    drawer?.querySelector('[aria-hidden="true"]')?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer?.classList.contains('translate-x-full')) {
        closeDrawer();
      }
    });

    // Focus trap
    drawer?.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        const focusable = drawer.querySelectorAll('a[href], button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Update filter count
    function updateFilterCount() {
      const count = document.querySelectorAll('.chip--selected').length;
      document.querySelectorAll('.filter-count').forEach(badge => badge.textContent = count);
    }

    document.querySelectorAll('.chip-group').forEach(group => {
      const observer = new MutationObserver(updateFilterCount);
      group.querySelectorAll('.chip').forEach(chip => {
        observer.observe(chip, { attributes: true, attributeFilter: ['class'] });
      });
    });

    // Load map button
    document.getElementById('load-search-map-btn')?.addEventListener('click', () => {
      const container = document.getElementById('search-map-container');
      const controls = document.getElementById('map-controls');
      const placeholder = container?.querySelector('.flex.items-center.justify-center');

      if (placeholder) placeholder.style.display = 'none';
      controls?.classList.remove('hidden');

      console.log('Inicializar MapLibre GL JS...');
    });

    // Clear filters sidebar
    document.getElementById('search-clear-filters')?.addEventListener('click', () => {
      document.querySelectorAll('.chip-group').forEach(group => {
        group.querySelectorAll('.chip--selected').forEach(c => {
          c.classList.remove('chip--selected');
          c.setAttribute('aria-checked', 'false');
        });
      });
      document.querySelectorAll('input[type="number"], input[type="search"]').forEach(input => input.value = '');
      updateFilterCount();
    });
  })();
</script>

<style>
  .search-page {
    @apply min-h-screen;
  }

  .search-form {
    @apply transition-shadow duration-300;
  }

  .search-form:focus-within {
    @apply shadow-xl ring-2 ring-[var(--color-accent)] ring-offset-2 ring-offset-[var(--color-white)];
  }

  .view-btn[aria-pressed="true"] {
    @apply bg-[var(--color-accent-gold)] text-[var(--color-text-on-gold)];
  }

  .view-btn[aria-pressed="true"] svg {
    stroke: var(--color-text-on-gold);
  }

  /* Split view */
  .split-view {
    @apply min-h-[60vh];
  }

  .map-panel {
    @apply relative;
  }

  .map-panel.lg\:sticky {
    @apply lg:sticky lg:top-24;
  }

  #search-map-container {
    @apply aspect-video lg:aspect-auto lg:h-full;
  }

  .map-controls {
    @apply animate-slide-down;
  }

  .map-popup {
    @apply animate-scale-in;
  }

  /* Mobile drawer */
  #search-filters-drawer.translate-x-0 {
    transform: translateX(0);
  }

  #search-filters-drawer.translate-x-full {
    transform: translateX(100%);
  }

  /* Results panel scroll */
  .results-panel {
    @apply lg:pr-2;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .search-form,
    .view-btn,
    .chip,
    #search-filters-drawer,
    .map-controls,
    .map-popup {
      transition: none !important;
      animation: none !important;
    }
  }
</style>